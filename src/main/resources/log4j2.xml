<Configuration status="INFO">
	<Properties>
		<property name="filePattern">${date:yyyyMMdd-HHmmss}</property>
		<property name="appName">app</property>
	</Properties>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<ThresholdFilter level="DEBUG"
                             onMatch="ACCEPT"
                             onMismatch="DENY"/>
			<PatternLayout
				pattern="%d{HH:mm:ss.SSS} [%t] %-5level - %msg%n" />
		</Console>
		<File name="File" fileName="logs/${appName}_${filePattern}.log">
			<PatternLayout pattern="%d{ISO8601} [%t] %-5p - %m%n" />
		</File>
	</Appenders>
	<Loggers>
		<Root level="debug">
			<AppenderRef ref="File" />
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>