<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.rochebobois.omnicanal.tools</groupId>
	<artifactId>anonymization-from-ecolix</artifactId>
	<version>0.0.1</version>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-mule</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-sfsc</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-myorders</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-mule</artifactId>
			<version>1.0.0</version>
		</dependency>

		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-dotdigital</artifactId>
			<version>0.0.1</version>
		</dependency>

		<dependency>
			<groupId>com.rochebobois.omnicanal</groupId>
			<artifactId>api-client-ecolix</artifactId>
			<version>0.1.0</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<transformers>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>
										com.rochebobois.omnicanal.tools.anonymization.AnonymizationFromEcolix</mainClass>
								</transformer>
								<transformer
									implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
									<resource>
										META-INF/org/apache/logging/log4j/core/config/plugins/Log4j2Plugins.dat</resource>
								</transformer>
							</transformers>
							<filters>
								<filter>
									<artifact>*:*</artifact>
									<excludes>
										<exclude>META-INF/*.SF</exclude>
										<exclude>META-INF/*.DSA</exclude>
										<exclude>META-INF/*.RSA</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>